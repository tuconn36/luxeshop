# ============ DATABASE ============
# Trên Railway: tạo PostgreSQL database, copy connection variables ở tab "Variables"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luxe_jewelry
DB_USER=postgres
DB_PASSWORD=changeme

# ============ SERVER ============
# Railway tự set PORT. Local mặc định 5000.
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# ============ JWT ============
# Tạo chuỗi ngẫu nhiên dài >= 32 ký tự: https://randomkeygen.com
JWT_SECRET=PLEASE-CHANGE-ME-TO-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS

# ============ CORS ============
# Domain đầy đủ của frontend, phân cách bằng dấu phẩy. KHÔNG có dấu / ở cuối.
# Ví dụ: https://luxeshop.vn,https://www.luxeshop.vn,https://admin.luxeshop.vn
CORS_ORIGIN=https://luxeshop.vn,https://www.luxeshop.vn,https://admin.luxeshop.vn

# ============ APP ============
APP_NAME=Luxe Jewelry
APP_URL=https://luxeshop.vn

# OTP hết hạn sau bao nhiêu phút
OTP_EXPIRE_MINUTES=10

# ============ EMAIL OTP (Gmail SMTP) ============
# Bước 1: Bật 2FA cho Gmail
# Bước 2: Vào https://myaccount.google.com/apppasswords -> tạo App Password
# Bước 3: Copy 16 ký tự vào SMTP_PASS (bỏ khoảng trắng)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
OTP_FROM="Luxe Jewelry <your-gmail@gmail.com>"

# ============ SMS OTP (tuỳ chọn - chỉ dùng nếu muốn SMS) ============
# --- Twilio ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1234567890
#
# --- eSMS.vn (Việt Nam) ---
# SMS_PROVIDER=esms
# ESMS_API_KEY=xxxxxxxx
# ESMS_SECRET=xxxxxxxx
# ESMS_BRANDNAME=LuxeJewelry

# ============ FILE UPLOAD ============
MAX_UPLOAD_MB=10