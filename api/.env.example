# ============================================
# API Environment (Production template)
# Copy file này thành .env và điền giá trị thật
# Hoặc set trực tiếp trên Railway dashboard
# ============================================

# Database (Railway tự cấp DATABASE_URL - dùng cái này)
# DB_URL ví dụ: <protocol>://user:password@host:port/dbname
# KHÔNG dùng nguyên literal "postgres://..." hay "postgresql://..." trong file này
# vì Railpack (builder mới của Railway) sẽ auto-detect và cố resolve thành service
# reference, dẫn đến build fail: "failed to solve: secret postgresql not found".
# Set DATABASE_URL trong Railway Variables thay vì để literal trong .env.example.
# DB_URL=<set-trong-railway-variables>

# Nếu KHÔNG dùng DATABASE_URL thì dùng 4 biến dưới
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Server
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# JWT - BẮT BUỘC đổi, dùng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS - Domain web (Vercel). Nếu nhiều domain: cách nhau dấu phẩy
# VD: https://luxe-web.vercel.app,https://luxe.vn
CORS_ORIGIN=

# SMTP - Gửi email OTP/đơn hàng (tuỳ chọn)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Twilio - Gửi OTP SMS (tuỳ chọn)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ============================================
# Thanh toán VietQR (dynamic QR qua vietqr.io)
# ============================================
# Số tài khoản + tên chủ TK cho từng ngân hàng.
# Để trống accountNumber = NH đó sẽ bị ẩn khỏi UI user.
# Set BANK_XXX_ENABLED=false để tắt NH đó.
BANK_VCB_ACCOUNT=1039544003
BANK_VCB_NAME=HÀ ANH TÚ
BANK_VCB_ENABLED=true

BANK_MB_ACCOUNT=0353511024
BANK_MB_NAME=HÀ ANH TÚ
BANK_MB_ENABLED=true

BANK_TCB_ACCOUNT=106846179999
BANK_TCB_NAME=HÀ ANH TÚ
BANK_TCB_ENABLED=true

# ============================================
# Sepay webhook (tự động đối soát khi CK vào TK)
# Đăng ký tại https://sepay.vn → lấy API Key
# Webhook URL: https://<your-api-domain>/api/payment/sepay-webhook
# ============================================
SEPAY_API_KEY=