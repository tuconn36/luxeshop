# ============================================
# API Environment (Production template)
# Copy file này thành .env và điền giá trị thật
# Hoặc set trực tiếp trên Railway dashboard
# ============================================

# Database (Railway tự cấp DATABASE_URL - dùng cái này)
# DB_URL ví dụ: <protocol>://user:password@host:port/dbname
# KHÔNG dùng nguyên literal "postgres://..." hay "postgresql://..." trong file này
# vì Railpack (builder mới của Railway) sẽ auto-detect và cố resolve thành service
# reference, dẫn đến build fail: "failed to solve: secret postgresql not found".
# Set DATABASE_URL trong Railway Variables thay vì để literal trong .env.example.
# DB_URL=<set-trong-railway-variables>

# Nếu KHÔNG dùng DATABASE_URL thì dùng 4 biến dưới
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Server
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# JWT - BẮT BUỘC đổi, dùng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS - Domain web (Vercel). Nếu nhiều domain: cách nhau dấu phẩy
# VD: https://luxe-web.vercel.app,https://luxe.vn
CORS_ORIGIN=

# SMTP - Gửi email OTP/đơn hàng (tuỳ chọn)
# Để TRỐNG SMTP_USER → OTP email chỉ log ra api/logs/otp.log (dev only)
#
# === Local dev: Mock SMTP (khuyến nghị khi chưa có Gmail) ===
# Terminal 1: npm run mail:mock     → listen 127.0.0.1:2525, in OTP ra terminal
# Sau đó dùng cấu hình dưới đây trong .env, gọi API bình thường → mail sẽ "gửi thật"
# qua TCP socket vào mock server (cùng code path như Gmail, chỉ khác destination).
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
OTP_FROM="Luxe Jewelry <dev@localhost>"
#
# === Gmail (production) ===
# Bước 1: Bật 2-Step Verification trên Google Account
# Bước 2: Tạo App Password tại https://myaccount.google.com/apppasswords
#         → chọn App = "Mail", Device = "Other (Custom name)" → tạo
#         → Google cho 1 mật khẩu 16 ký tự, copy vào SMTP_PASSWORD bên dưới
# Bước 3: Set OTP_FROM đúng địa chỉ Gmail của bạn (Gmail từ chối gửi từ alias khác domain)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# OTP_FROM="Luxe Jewelry <your-gmail@gmail.com>"
#
# === Resend.com (nếu không muốn dùng Gmail) ===
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=<re_xxxxxxxxxx>
# OTP_FROM="Luxe Jewelry <hello@yourdomain.com>"

# ============================================
# SMS OTP Provider (chọn 1: twilio HOẶC esms)
# Để TRỐNG SMS_PROVIDER → chỉ log OTP ra api/logs/otp.log (dev only)
# ============================================

# --- eSMS.vn (khuyến nghị cho Việt Nam) ---
# Đăng ký tài khoản tại https://esms.vn, lấy API Key + Secret ở dashboard.
# Brandname phải đăng ký trước với eSMS (vd "LuxeJewelry").
SMS_PROVIDER=
ESMS_API_KEY=
ESMS_SECRET=
ESMS_BRANDNAME=
ESMS_SEND_URL=https://api.esms.vn/MainService.svc/json/SendMessageAutoGen

# --- Twilio (quốc tế, E.164) ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_FROM=+1234567890

# ============================================
# Thanh toán VietQR (dynamic QR qua vietqr.io)
# ============================================
# Số tài khoản + tên chủ TK cho từng ngân hàng.
# Để trống accountNumber = NH đó sẽ bị ẩn khỏi UI user.
# Set BANK_XXX_ENABLED=false để tắt NH đó.
BANK_VCB_ACCOUNT=1039544003
BANK_VCB_NAME=HÀ ANH TÚ
BANK_VCB_ENABLED=true

BANK_MB_ACCOUNT=0353511024
BANK_MB_NAME=HÀ ANH TÚ
BANK_MB_ENABLED=true

BANK_TCB_ACCOUNT=106846179999
BANK_TCB_NAME=HÀ ANH TÚ
BANK_TCB_ENABLED=true

# ============================================
# Sepay webhook (tự động đối soát khi CK vào TK)
# Đăng ký tại https://sepay.vn → lấy API Key
# Webhook URL: https://<your-api-domain>/api/payment/sepay-webhook
# ============================================
SEPAY_API_KEY=